# 必填密钥，请勿将真实 .env 文件提交到版本库。
# 建议使用 hex 字符串生成，避免 URL 保留字符影响数据库连接串解析。
# POSTGRES_PASSWORD 使用 openssl rand -hex 24 生成。
# JWT_SECRET 至少 32 字节，使用 openssl rand -hex 32 生成。
# AES_KEY 为 32 字节 hex 或 base64 字符串，使用 openssl rand -hex 32 生成。
# DOCREADER_TOKEN 使用 openssl rand -hex 24 生成。
POSTGRES_PASSWORD=
JWT_SECRET=
AES_KEY=
DOCREADER_TOKEN=

# 宿主机对外暴露端口，仅 web 容器开放端口。
WEB_PORT=80

# 可选账号与安全配置
# BCRYPT_COST=10
# EMAIL_VERIFICATION_REQUIRED=false

# 可选后台任务、切块与检索参数
# INGEST_WORKERS=2
# GRAPH_WORKERS=2
# EMBED_BATCH_SIZE=16
# CHUNK_MIN=500
# CHUNK_MAX=800
# CHUNK_OVERLAP=100
# PARENT_MIN=2000
# PARENT_MAX=3000
# TOP_K=5
# RRF_K=60
# BM25_K1=1.2
# BM25_B=0.75
# DEFAULT_THRESHOLD=0.3
# MODEL_TIMEOUT_SECONDS=60
# DOCREADER_TIMEOUT_SECONDS=120
